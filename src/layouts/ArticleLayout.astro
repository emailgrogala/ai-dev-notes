---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import AiAssistedNote from '../components/AiAssistedNote.astro';
import ReadingAids from '../components/ReadingAids.astro';
import NextTokenSandbox from '../components/NextTokenSandbox.astro';
import ArticleInsights from '../components/ArticleInsights.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import ArticleViews from '../components/ArticleViews.astro';
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  date: Date;
  lang: 'pl' | 'en';
  translationKey: string;
  tags?: string[];
  insights?: string[];
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
}

const {
  title,
  description,
  date,
  lang,
  translationKey,
  tags = [],
  insights = [],
  heroImage,
  heroImageAlt,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat(
  lang === 'pl' ? 'pl-PL' : 'en-GB',
  {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }
).format(date);

const enlargeLabel = lang === 'pl' ? 'Powiększ' : 'Enlarge';
const currentTags = new Set(tags);
const currentDate = date.valueOf();

const publishedArticles = await getCollection(
  'articles',
  ({ data }) => !data.draft
);
const translationLanguages = new Set(
  publishedArticles
    .filter((article) => article.data.translationKey === translationKey)
    .map((article) => article.data.lang)
);
const plAlternateHref = translationLanguages.has('pl')
  ? withBase(`pl/articles/${translationKey}/`)
  : undefined;
const enAlternateHref = translationLanguages.has('en')
  ? withBase(`en/articles/${translationKey}/`)
  : undefined;
const plHref = plAlternateHref ?? withBase('pl/');
const enHref = enAlternateHref ?? withBase('en/');

const relatedArticles = publishedArticles
  .filter(({ data }) => data.lang === lang && data.translationKey !== translationKey)
  .map((article) => ({
    title: article.data.title,
    href: withBase(`${lang}/articles/${article.data.translationKey}/`),
    sharedTagCount: article.data.tags.filter((tag) => currentTags.has(tag)).length,
    dateDistance: Math.abs(article.data.date.valueOf() - currentDate),
    date: article.data.date.valueOf(),
  }))
  .sort((a, b) =>
    b.sharedTagCount - a.sharedTagCount ||
    a.dateDistance - b.dateDistance ||
    b.date - a.date
  )
  .slice(0, 3);
---

<BaseLayout
  title={`${title} | AI Dev Notes`}
  description={description}
  lang={lang}
  plHref={plAlternateHref}
  enHref={enAlternateHref}
>
  <div class="page">
    <Header lang={lang} plHref={plHref} enHref={enHref} />
    <ReadingAids />
    <NextTokenSandbox />

    <main class="article-shell">
      <article class="article">
        <header class="article-header">
          <h1>{title}</h1>

          <p class="article-description">{description}</p>

          <div class="article-meta">
            <time datetime={date.toISOString()}>{formattedDate}</time>

            <ArticleViews slug={translationKey} lang={lang} />

            {tags.length > 0 && (
              <div class="tags">
                {tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            )}
          </div>
        </header>

        <ArticleInsights insights={insights} lang={lang} />

        <div class="article-content">
          {heroImage && heroImageAlt && (
            <figure class="article-hero-image">
              <a
                class="article-image-link"
                href={heroImage.src}
                target="_blank"
                rel="noopener"
                aria-label={`${enlargeLabel}: ${heroImageAlt}`}
              >
                <Picture
                  src={heroImage}
                  formats={['avif', 'webp']}
                  fallbackFormat="png"
                  widths={[480, 760, 1200, 1672]}
                  sizes="(max-width: 640px) calc(100vw - 32px), 760px"
                  alt={heroImageAlt}
                  loading="lazy"
                  decoding="async"
                />
                <span class="article-image-link__label">
                  {enlargeLabel}
                  <span aria-hidden="true">↗</span>
                </span>
              </a>
            </figure>
          )}
          <slot />
        </div>

        <AiAssistedNote lang={lang} />
        <RelatedArticles articles={relatedArticles} lang={lang} />
      </article>
    </main>
  </div>
</BaseLayout>

<style is:global>
  .article-shell {
    width: min(1080px, calc(100% - 40px));
    margin: 0 auto;
    padding: 68px 0 96px;
  }

  .article {
    width: min(760px, 100%);
    min-width: 0;
    margin: 0 auto;
  }

  .article-header {
    margin-bottom: 36px;
  }

  .article-header h1 {
    margin: 0;
    font-size: clamp(2.35rem, 4.8vw, 3.4rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .article-description {
    margin: 20px 0 0;
    max-width: 720px;
    color: #475569;
    font-size: 1.08rem;
    line-height: 1.62;
  }

  .article-meta {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 18px;
    align-items: center;
    color: #64748b;
    font-size: 0.88rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    padding: 5px 9px;
    border: 1px solid #dbe3ec;
    border-radius: 999px;
    background: #fff;
    color: #475569;
    font-size: 0.76rem;
    line-height: 1;
  }

  .article-content {
    min-width: 0;
    color: #1f2937;
    font-size: 1.075rem;
    line-height: 1.75;
  }

  .article-content :where(h2, h3, p, li, blockquote, a) {
    overflow-wrap: anywhere;
  }

  .article-content p {
    margin: 0 0 1.35em;
  }

  .article-content h2 {
    margin: 3rem 0 1rem;
    font-size: 1.65rem;
    line-height: 1.28;
    letter-spacing: -0.02em;
  }

  .article-content h3 {
    margin: 2.35rem 0 0.85rem;
    font-size: 1.3rem;
    line-height: 1.3;
  }

  .article-content ul,
  .article-content ol {
    margin: 0 0 1.5rem;
    padding-left: 1.4rem;
  }

  .article-content li + li {
    margin-top: 0.35rem;
  }

  .article-content blockquote {
    margin: 1.75rem 0;
    padding-left: 1.2rem;
    border-left: 3px solid #cbd5e1;
    color: #475569;
  }

  .article-content pre {
    max-width: 100%;
    margin: 1.75rem 0;
    padding: 18px 20px;
    overflow-x: auto;
    overflow-wrap: normal;
    word-break: normal;
    border-radius: 10px;
    background: #22272e;
    color: #f8fafc;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  /* Image handling fix */
  .article-content img,
  .article-content picture,
  .article-content figure {
    display: block;
    max-width: 100%;
    box-sizing: border-box;
  }

  .article-content img {
    width: 100%;
    height: auto;
    margin: 1.75rem auto;
    border-radius: 12px;
  }

  .article-content picture img {
    margin: 0;
  }

  .article-content figure {
    width: 100%;
    margin: 1.75rem 0;
  }

  .article-content figure img {
    margin: 0;
  }

  .article-image-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .article-image-link:focus-visible {
    outline: 2px solid #111827;
    outline-offset: 5px;
    border-radius: 12px;
  }

  .article-image-link__label {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #475569;
    font-size: 0.88rem;
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article-content figcaption {
    margin-top: 0.75rem;
    color: #64748b;
    font-size: 0.92rem;
    line-height: 1.5;
    text-align: center;
  }

  @media (max-width: 640px) {
    .article-shell {
      width: min(100% - 32px, 1080px);
      padding-top: 42px;
      padding-bottom: 72px;
    }

    .article-header h1 {
      font-size: clamp(2.15rem, 10vw, 2.9rem);
      line-height: 1.06;
    }

    .article-description {
      font-size: 1rem;
    }

    .article-content {
      font-size: 1rem;
      line-height: 1.72;
    }

    .article-content h2 {
      font-size: 1.5rem;
    }

    .article-content img {
      border-radius: 10px;
    }
  }
</style>
