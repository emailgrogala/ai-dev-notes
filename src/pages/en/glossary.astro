---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Glossary from "../../components/Glossary.astro";
import Header from "../../components/Header.astro";
import { withBase } from "../../utils/paths";

const plHref = withBase("pl/glossary/");
const enHref = withBase("en/glossary/");
---

<BaseLayout
  lang="en"
  title="Glossary — AI Dev Notes"
  description="A short glossary of terms used across AI Dev Notes: LLM, RAG, model training, fine-tuning, MCP, agents, tokens, and more."
  plHref={plHref}
  enHref={enHref}
>
  <div class="page">
    <Header lang="en" plHref={plHref} enHref={enHref} />

    <main class="glossary-shell">
      <Glossary lang="en" />
    </main>
  </div>
</BaseLayout>

<style>
  .glossary-shell {
    width: min(1080px, calc(100% - 40px));
    margin: 0 auto;
    padding: 68px 0 96px;
  }

  @media (max-width: 640px) {
    .glossary-shell {
      width: min(100% - 32px, 1080px);
      padding-top: 42px;
      padding-bottom: 72px;
    }
  }
</style>
