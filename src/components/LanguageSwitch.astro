---
interface Props {
  lang: 'pl' | 'en';
  plHref?: string;
  enHref?: string;
}

const {
  lang,
  plHref = '/pl/',
  enHref = '/en/'
} = Astro.props;

const navLabel = lang === 'pl' ? 'Wybór języka' : 'Language selection';
---

<nav class="language-switch" aria-label={navLabel}>
  <a
    href={plHref}
    aria-current={lang === 'pl' ? 'page' : undefined}
  >
    PL
  </a>

  <span>/</span>

  <a
    href={enHref}
    aria-current={lang === 'en' ? 'page' : undefined}
  >
    EN
  </a>
</nav>

<style>
  .language-switch {
    display: flex;
    gap: 2px;
    align-items: center;
    font-size: 0.9rem;
  }

  .language-switch a {
    min-width: 32px;
    min-height: 44px;
    margin-block: -12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #64748b;
  }

  .language-switch a:hover {
    color: #111827;
  }

  .language-switch a[aria-current="page"] {
    color: #111827;
    font-weight: 700;
  }

  .language-switch span {
    color: #cbd5e1;
  }
</style>
